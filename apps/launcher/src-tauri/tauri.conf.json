{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Private Client",
  "version": "1.2.0",
  "identifier": "com.privateclient.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Private Client",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; frame-src 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob: https://textures.minecraft.net https://cdn.modrinth.com; connect-src 'self' ipc: http://ipc.localhost https://api.modrinth.com https://cdn.modrinth.com https://piston-meta.mojang.com https://resources.download.minecraft.net https://github.com https://*.githubusercontent.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/Private Client/cache/profiles/**"
        ]
      },
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/swizzdev533/private-client/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxRjJEMjVCMkRDM0U1MTkKUldRWjVjTXRXOUx5NGNIM1R0c1M0TnJyU054ZXljMnVnT2ZwazUyZHZDY2lpcUdPalhtOFgrNGEK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Private Minecraft 1.8.9 Forge launcher",
    "longDescription": "A local-first, zero-telemetry launcher for an isolated Minecraft 1.8.9 Forge instance.",
    "copyright": "Copyright Private Client Contributors",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
