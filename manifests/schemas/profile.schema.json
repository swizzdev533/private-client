{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private-client.invalid/schemas/profile.schema.json",
  "title": "Private Client sanitized player profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "username",
    "uuid",
    "skinModel",
    "skinPath",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "username": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^[A-Za-z0-9_]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "skinModel": {
      "enum": ["classic", "slim"]
    },
    "skinPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^skins/[A-Fa-f0-9-]+\\.png$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
